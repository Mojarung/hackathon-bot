# --- Telegram ---
BOT_TOKEN=123456:AA...            # @BotFather; Privacy Mode must be OFF
# Comma-separated tg user ids allowed to mutate data; empty = chat admins.
# Comment above the line, not after it: dotenv keeps a trailing `# ...` as the
# value whenever the value itself is empty.
BOT_ADMIN_IDS=

# --- LLM (Ollama Cloud, OpenAI-compatible) ---
OLLAMA_API_KEY=
# Запасной ключ: подхватится, когда основной ответит ошибкой.
OLLAMA_API_KEY_FALLBACK=
OLLAMA_BASE_URL=https://ollama.com/v1
LLM_MODEL=minimax-m3               # tools + vision + живой русский
LLM_VISION_MODEL=minimax-m3       # image understanding (fallback: gemma4:31b)
LLM_FUN_MODEL=minimax-m3            # генератор шуток, русский язык у него чище
LLM_MAX_TOKENS=2048
# Отдельный провайдер только для разговорного агента (характер бота).
# Пусто = тот же Ollama. Пример для Featherless:
#   CHAT_BASE_URL=https://api.featherless.ai/v1
#   CHAT_API_KEY=rc_...
#   LLM_MODEL=huihui-ai/Huihui-Qwen3.8-27B-abliterated
CHAT_BASE_URL=
# Пустой ключ = берётся OLLAMA_API_KEY. Комментарий здесь стоит НАД строкой:
# у пустого значения dotenv забирает хвостовой `# ...` целиком в значение, и
# «ключа нет» превращается в живой мусорный ключ, на котором ложится весь агент.
CHAT_API_KEY=

# --- GitHub ---
GITHUB_TOKEN=
GITHUB_ORG=Mojarung
GITHUB_PRIVATE=true

# --- Google Calendar ---
# Пустой GOOGLE_CALENDAR_ID полностью выключает интеграцию: бот работает ровно
# как раньше и в календарь не ходит. Как получить ключ и идентификатор —
# docs/google-calendar.md.
# Вида abc123@group.calendar.google.com. Комментарий стоит НАД строкой не для
# красоты: у пустого значения dotenv не отрезает хвостовой `# ...`, а забирает
# его целиком в значение - и «выключено» превратилось бы во «включено с мусором».
GOOGLE_CALENDAR_ID=
# JSON сервис-аккаунта; data/ в .gitignore
GOOGLE_CREDENTIALS_FILE=data/google-service-account.json
GOOGLE_CALENDAR_SYNC_MINUTES=30           # полная сверка; правки уезжают сразу, не дожидаясь её

# --- App ---
TZ_DEFAULT=Europe/Moscow
DB_PATH=data/hackbot.db
FILES_DIR=data/files
WEB_HOST=0.0.0.0
WEB_PORT=9999
# e.g. http://1.2.3.4:9999 - used in .ics feed links and in calendar descriptions.
# Same trap as GOOGLE_CALENDAR_ID: an inline comment on an empty value becomes the value.
WEB_PUBLIC_URL=
CARD_REFRESH_SECONDS=60
STICKER_SET=mojarung
STICKER_CHANCE=0.25

# --- Незваные реплики: бот сам влезает в разговор ---
BANTER_CHANCE=0.25                # шанс на сообщение; 0 полностью выключает
BANTER_COOLDOWN_SECONDS=90        # пауза в теме, чтобы всплеск не стал монологом
BANTER_CONTEXT=8                  # сколько последних сообщений он читает
BANTER_EVERYWHERE=true            # false - оживать только в темах с хакатоном, молчать в General

# --- Реакции: бот молча вешает эмодзи на сообщение ---
REACTION_CHANCE=0.25              # шанс на сообщение; 0 полностью выключает
REACTION_COOLDOWN_SECONDS=60      # пауза в теме; реакция дешевле реплики, поэтому короче

LOG_LEVEL=INFO
