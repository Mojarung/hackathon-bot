# --- Telegram ---
BOT_TOKEN=123456:AA...            # @BotFather; Privacy Mode must be OFF
BOT_ADMIN_IDS=                    # comma-separated tg user ids allowed to mutate data (empty = chat admins)

# --- LLM (Ollama Cloud, OpenAI-compatible) ---
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
LLM_MODEL=minimax-m3               # tools + vision + живой русский
LLM_VISION_MODEL=minimax-m3       # image understanding (fallback: gemma4:31b)
LLM_FUN_MODEL=minimax-m3            # генератор шуток, русский язык у него чище
LLM_MAX_TOKENS=2048
# Отдельный провайдер только для разговорного агента (характер бота).
# Пусто = тот же Ollama. Пример для Featherless:
#   CHAT_BASE_URL=https://api.featherless.ai/v1
#   CHAT_API_KEY=rc_...
#   LLM_MODEL=huihui-ai/Huihui-Qwen3.8-27B-abliterated
CHAT_BASE_URL=
CHAT_API_KEY=               # reasoning models eat this; do not go low

# --- GitHub ---
GITHUB_TOKEN=
GITHUB_ORG=Mojarung
GITHUB_PRIVATE=true

# --- App ---
TZ_DEFAULT=Europe/Moscow
DB_PATH=data/hackbot.db
FILES_DIR=data/files
WEB_HOST=0.0.0.0
WEB_PORT=9999
WEB_PUBLIC_URL=                   # e.g. http://1.2.3.4:9999 - used in .ics feed links
CARD_REFRESH_SECONDS=60
STICKER_SET=mojarung
STICKER_CHANCE=0.25
LOG_LEVEL=INFO
